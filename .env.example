# --- Servidor ---
PORT=3000
BASE_URL=https://encontrados.co

# --- Base de datos ---
# En Vercel: agrega Vercel Postgres / Neon y usa su POSTGRES_URL o DATABASE_URL.
# Local: si no defines nada, usa SQLite en ./data/encontrados.db
# DATABASE_URL=postgres://user:pass@host/db

# --- API ---
# Si defines API_KEY, los POST del API requieren "Authorization: Bearer <API_KEY>".
# Las lecturas siempre son públicas.
#
# API_KEY es la llave de OPERACIÓN: abre las siete superficies con llave,
# incluido DELETE /api/people/:id, que es irreversible. Para que alguien aporte
# datos sin recibir todo eso, se emite una llave con alcance acotado, que vive en
# la base y no en el entorno:
#   npm run api-key -- emitir --alias voluntario-1 --alcance ingest
# Detalle en docs/llaves-de-api.md.
#
# OJO con la combinación peligrosa: si hay llaves emitidas y API_KEY NO está
# definida, el API cae al modo abierto de desarrollo y le da alcance de operación
# a cualquiera que simplemente no mande cabecera. Con llaves emitidas, esta
# variable es obligatoria.
# API_KEY=

# --- Email (SendGrid) ---
# El remitente está fijo en el código: a@torrenegra.com (src/env.js)
# SENDGRID_API_KEY=

# Buzón de operación: recibe los avisos de rescatistas y —en modo relevo— TODO
# aviso que iba a un tercero. Sin esta variable no se manda correo; el reporte y
# el aviso quedan guardados igual.
# AVISO_EMAIL=

# Modo de entrega de los avisos que van a un TERCERO (la actualización a quien
# sigue a una persona, y la coincidencia facial que le avisa a un rescatista
# que alguien la busca).
#   relay  (por omisión, también si la variable no está o trae un valor raro)
#          Nada sale al tercero: cada aviso se manda a AVISO_EMAIL para que una
#          persona verifique al destinatario y lo enrute. Entregarle el
#          contacto de una familia a un desconocido que dice haber rescatado a
#          alguien es un vector de extorsión; en este modo hay humano en el
#          circuito. Si AVISO_EMAIL no está puesta no se envía nada y queda un
#          "[notify:relevo] PERDIDO" con el aviso completo en los logs.
#   direct Envío directo al destinatario (el comportamiento anterior).
# La verificación de correo (doble opt-in) NUNCA se releva: va siempre directa
# al dueño de la dirección. `GET /api/diag` reporta el modo vigente.
# NOTIFY_MODE=relay

# --- Ideas y bugs (/ideas y /bug → issues de GitHub) ---
# Token con permiso de escribir issues en el repo. Sin él los formularios
# siguen funcionando: el mensaje se manda a AVISO_EMAIL para abrirlo a mano.
# GITHUB_TOKEN=
# GITHUB_REPO=encontradosco/encontrados

# --- Reconocimiento facial (AWS Rekognition) ---
# Sin estas credenciales las fotos se guardan pero no hay matching.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# FACE_COLLECTION_ID=aqui-faces   # NO renombrar: es la colección con los rostros ya indexados
# FACE_MATCH_THRESHOLD=90

# --- WhatsApp (Meta Cloud API) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=encontrados-verify

# Las dos plantillas aprobadas por Meta para hablarle a un rescatista que dejó
# su número en /rescate. Son obligatorias: ese rescatista llegó por la web, no
# hay ventana de 24 h abierta, y Meta rechaza (131047) cualquier mensaje
# iniciado por el negocio que no sea una plantilla aprobada.
#
# NO hace falta configurarlas: el código ya trae por omisión los nombres y el
# idioma aprobados. Estas variables existen solo para apuntar a otra plantilla
# (por ejemplo una nueva versión aprobada) o para APAGAR un envío poniéndolas
# en vacío. Inventar un nombre no sirve: Meta solo entrega lo que aprobó.
#
# Ninguna de las dos lleva un dato de la familia, y esa es la regla: por
# WhatsApp NUNCA sale el contacto de una familia.
#   1. confirmacion_rescatista_encontrados — {{1}} = nombre de la persona.
#      Pregunta si está con quien recibe el mensaje o si lo que hizo fue
#      reportarla; pide responder SÍ o REPORTE.
#   2. ficha_fuente_rescatista_encontrados — {{1}} = nombre, {{2}} = URL de la
#      ficha en el registro público de origen. Es lo único que sale tras un SÍ:
#      lo manda a marcar a la persona como localizada allá, porque el contacto
#      de la familia lo tiene ese registro y nosotros no.
# WHATSAPP_TEMPLATE_RESCUE_CONFIRM=confirmacion_rescatista_encontrados
# WHATSAPP_TEMPLATE_RESCUE_SOURCE=ficha_fuente_rescatista_encontrados
# Para Meta `es` y `es_CO` son idiomas DISTINTOS: pedir el que no es equivale a
# que no llegue nada.
# WHATSAPP_TEMPLATE_LOCALE=es_CO

# Credencial que exige `POST /webhooks/whatsapp`. Meta no le habla directo a
# este endpoint: entrega a un relevo que verifica la firma HMAC y reenvía el
# cuerpo intacto con la cabecera `X-Relay-Secret`. Como ese relevo es el único
# cliente legítimo, un secreto compartido alcanza y es más estricto que
# reimplementar la verificación de firma acá.
# Sin esta variable el POST responde 403 a TODO: el webhook escribe en la base
# (crea personas, updates y suscripciones) y falla cerrado a propósito. El GET
# del handshake no la necesita, es una lectura.
# Generar con: openssl rand -hex 32
# WHATSAPP_RELAY_SECRET=

# Servicio de embeddings de mascotas (pet-matcher/) — opcional, sin ella el matching de mascotas queda apagado
PET_MATCH_API_URL=
PET_MATCH_THRESHOLD=80
PET_MATCH_SHARED_SECRET=cambia-esto-por-un-secreto-generado-con-openssl-rand-hex-32
